{
  "expo": {
    "name": "NoKey",
    "slug": "voicedeck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-nokey.png",
    "scheme": "voicedeck",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "site.fishcloud.nokey",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "连接你已配对的 Mac，传送实时语音及快捷操作。",
        "NSCameraUsageDescription": "扫描 Mac 客户端上的配对二维码。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSMicrophoneUsageDescription": "将手机麦克风声音实时传送到你已配对的 Mac。",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSBonjourServices": [
          "_nokey._tcp"
        ]
      },
      "appleTeamId": "VMF4ZH3PR2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-nokey.png"
    },
    "plugins": [
      "./plugins/with-scene-lifecycle",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-nokey.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F3"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "扫描 Mac 客户端上的配对二维码。",
          "microphonePermission": "将手机麦克风声音实时传送到你已配对的 Mac。"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "将手机麦克风声音实时传送到你已配对的 Mac。",
          "cameraPermission": "扫描 Mac 客户端上的配对二维码。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
